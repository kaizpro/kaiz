NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set NEXT_PUBLIC_SITE_URL to the canonical production origin in Vercel.
# Vercel deployment URLs are used only as a defensive server-side fallback.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Preferred current Supabase browser key. It is intentionally public and protected by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead of the publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# No service-role or secret key is required for Milestone 1. Never expose one with NEXT_PUBLIC_.
