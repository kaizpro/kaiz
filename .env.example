NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Scope the canonical NEXT_PUBLIC_SITE_URL to Production only in Vercel.
# Preview auth uses VERCEL_URL / VERCEL_BRANCH_URL, never this production value.
# Preview Supabase URL/key must belong to an isolated test project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Preferred current Supabase browser key. It is intentionally public and protected by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# Legacy projects may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead of the publishable key.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# No service-role or secret key is required for Milestone 1. Never expose one with NEXT_PUBLIC_.
